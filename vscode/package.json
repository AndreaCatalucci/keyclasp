{
  "name": "keyblind",
  "displayName": "Keyblind — Blind AI to Your Keys",
  "description": "Encrypted secrets vault that keeps API keys hidden from AI agents. Sandbox .env files, resolve secrets at runtime.",
  "version": "0.1.0",
  "publisher": "keyblind",
  "license": "MIT",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/AndreaCatalucci/keyblind"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Linters"],
  "keywords": ["secrets", "security", "api-keys", "env", "ai", "mcp", "keyblind"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "keyblind.init",
        "title": "Keyblind: Initialize Vault"
      },
      {
        "command": "keyblind.storeSecret",
        "title": "Keyblind: Store Secret"
      },
      {
        "command": "keyblind.listSecrets",
        "title": "Keyblind: List Secrets"
      },
      {
        "command": "keyblind.sandbox",
        "title": "Keyblind: Sandbox .env"
      },
      {
        "command": "keyblind.unsandbox",
        "title": "Keyblind: Unsandbox .env"
      },
      {
        "command": "keyblind.startServer",
        "title": "Keyblind: Start MCP Server"
      },
      {
        "command": "keyblind.watchEnv",
        "title": "Keyblind: Watch .env for Changes"
      }
    ],
    "configuration": {
      "title": "Keyblind",
      "properties": {
        "keyblind.projectName": {
          "type": "string",
          "default": "",
          "description": "Project name for isolated vault (uses --project flag)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "cd ../ && npm run build && cd vscode && tsc",
    "compile": "tsc",
    "watch": "tsc --watch"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
