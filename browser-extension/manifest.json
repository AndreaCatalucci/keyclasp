{
  "manifest_version": 3,
  "name": "Keyblind — Blind AI to Your Keys",
  "version": "0.1.0",
  "description": "Detect and protect API keys on web pages. Intercepts paste events on AI chat sites to prevent secret leaks.",
  "permissions": ["storage", "clipboardRead", "scripting", "activeTab"],
  "host_permissions": [
    "https://github.com/*",
    "https://pastebin.com/*",
    "https://claude.ai/*",
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://*.githubcopilot.com/*",
    "https://*.cursor.sh/*"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*",
        "https://pastebin.com/*",
        "https://claude.ai/*",
        "https://chat.openai.com/*",
        "https://chatgpt.com/*",
        "https://*.githubcopilot.com/*",
        "https://*.cursor.sh/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
