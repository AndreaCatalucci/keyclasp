{
  "name": "keyblind",
  "displayName": "Keyblind",
  "description": "Blind AI to your API keys — encrypted secrets vault for VS Code",
  "version": "0.1.0",
  "publisher": "keyblind",
  "icon": "icon.png",
  "repository": "https://github.com/aarifmms/keyblind",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Other"],
  "keywords": ["secrets", "encryption", "security", "vault", "api-key", "mcp"],
  "activationEvents": [
    "onView:keyblind.secrets",
    "onCommand:keyblind.sandbox",
    "onCommand:keyblind.unsandbox",
    "onCommand:keyblind.storeSecret",
    "onCommand:keyblind.resolveSecret",
    "onCommand:keyblind.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "keyblind",
          "title": "Keyblind",
          "icon": "$(shield)"
        }
      ]
    },
    "views": {
      "keyblind": [
        {
          "id": "keyblind.secrets",
          "name": "Secrets",
          "icon": "$(key)"
        }
      ]
    },
    "commands": [
      {
        "command": "keyblind.sandbox",
        "title": "Keyblind: Sandbox .env",
        "icon": "$(shield)"
      },
      {
        "command": "keyblind.unsandbox",
        "title": "Keyblind: Restore .env",
        "icon": "$(unlock)"
      },
      {
        "command": "keyblind.storeSecret",
        "title": "Keyblind: Store Secret",
        "icon": "$(save)"
      },
      {
        "command": "keyblind.resolveSecret",
        "title": "Keyblind: Copy Secret Value",
        "icon": "$(copy)"
      },
      {
        "command": "keyblind.generateSecret",
        "title": "Keyblind: Generate Secret",
        "icon": "$(wand)"
      },
      {
        "command": "keyblind.refresh",
        "title": "Keyblind: Refresh",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "keyblind.refresh",
          "when": "view == keyblind.secrets",
          "group": "navigation"
        },
        {
          "command": "keyblind.storeSecret",
          "when": "view == keyblind.secrets",
          "group": "navigation"
        },
        {
          "command": "keyblind.generateSecret",
          "when": "view == keyblind.secrets",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "keyblind.resolveSecret",
          "when": "view == keyblind.secrets && viewItem == secret",
          "group": "inline"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsc",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "typescript": "^5.5.0"
  }
}
